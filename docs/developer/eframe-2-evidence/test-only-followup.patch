diff --git a/apps/lab-workbench/src/parent/renderer_tests.rs b/apps/lab-workbench/src/parent/renderer_tests.rs
index a3dd9f4..a984f59 100644
--- a/apps/lab-workbench/src/parent/renderer_tests.rs
+++ b/apps/lab-workbench/src/parent/renderer_tests.rs
@@ -72,0 +73,28 @@ fn wait(mut predicate: impl FnMut() -> bool) {
+fn observed_ipc_status(
+    mut read: impl FnMut() -> Result<crate::private_ipc::TestStatus, &'static str>,
+) -> crate::private_ipc::TestStatus {
+    let mut observed = None;
+    wait(|| match read() {
+        Ok(status) => {
+            observed = Some(status);
+            true
+        }
+        Err("IPC metadata busy") => false,
+        Err(error) => panic!("unexpected IPC observation error: {error}"),
+    });
+    observed.expect("checked metadata observation")
+}
+#[test]
+fn metadata_busy_is_not_a_retirement_receipt_and_does_not_panic_the_observer() {
+    let mut attempts = 0;
+    let status = observed_ipc_status(|| {
+        attempts += 1;
+        if attempts == 1 {
+            Err("IPC metadata busy")
+        } else {
+            Ok(Default::default())
+        }
+    });
+    assert_eq!(attempts, 2);
+    assert!(!status.retired);
+}
